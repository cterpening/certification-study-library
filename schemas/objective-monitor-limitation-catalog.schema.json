{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Known objective-monitor limitation catalog",
  "type": "object",
  "required": ["schema_version", "limitations"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codes", "expected_error", "reason", "review_route", "last_reviewed"],
        "properties": {
          "codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]+$" }
          },
          "expected_error": {
            "type": "string",
            "pattern": "^(HTTPError|URLError|TimeoutError|ValueError): .+"
          },
          "reason": { "type": "string", "minLength": 1 },
          "review_route": { "const": "docs/SOURCE-FRESHNESS.md" },
          "last_reviewed": { "type": "string", "format": "date" }
        }
      }
    }
  },
  "additionalProperties": false
}
