{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accepted catalog listing observations",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "contract", "checked_on", "items"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "contract": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "checked_on": {"type": "string", "format": "date"},
          "items": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["key", "url", "title"],
              "properties": {
                "key": {"type": "string", "minLength": 1},
                "url": {"type": "string", "format": "uri", "pattern": "^https://"},
                "title": {"type": "string", "minLength": 1},
                "detail": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
