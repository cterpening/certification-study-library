{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certification enrichment seed catalog",
  "type": "object",
  "required": ["schema_version", "catalog_sources", "certifications"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "catalog_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "vendor_id", "catalog_url", "selection", "last_verified"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "vendor_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "catalog_url": { "type": "string", "format": "uri" },
          "selection": { "type": "string", "minLength": 1 },
          "last_verified": { "type": "string", "format": "date" }
        }
      }
    },
    "certifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vendor_id", "exam_code", "title", "official_url", "status", "source_id"],
        "properties": {
          "vendor_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "exam_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "official_url": { "type": "string", "format": "uri" },
          "status": { "enum": ["active", "beta", "retirement-announced", "retired"] },
          "source_id": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      }
    }
  },
  "additionalProperties": false
}
