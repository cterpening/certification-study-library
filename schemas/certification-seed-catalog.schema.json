{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certification enrichment seed catalog",
  "type": "object",
  "required": ["schema_version", "catalog_sources", "certifications"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "lifecycle_as_of": { "type": "string", "format": "date" },
    "catalog_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "vendor_id", "catalog_url", "selection", "last_verified"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "vendor_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "catalog_url": { "type": "string", "format": "uri" },
          "selection": { "type": "string", "minLength": 1 },
          "last_verified": { "type": "string", "format": "date" }
        }
      }
    },
    "certifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vendor_id", "exam_code", "title", "official_url", "status", "source_id"],
        "properties": {
          "vendor_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "exam_code": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "pattern": "^\\S(?:[^\\t\\r\\n]*\\S)?$" }
          },
          "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["checked_on"],
            "properties": {
              "checked_on": { "type": "string", "format": "date" },
              "notes": { "type": "string", "minLength": 1 },
              "source_urls": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
              "blueprint_updates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["effective_on", "language", "source_url"],
                  "properties": {
                    "effective_on": { "type": "string", "format": "date" },
                    "language": { "type": "string", "minLength": 1 },
                    "source_url": { "type": "string", "format": "uri" }
                  }
                }
              },
              "initial_release": {
                "type": "object",
                "additionalProperties": false,
                "required": ["date", "stage", "source_url"],
                "properties": {
                  "date": { "type": "string", "format": "date" },
                  "stage": { "enum": ["beta", "general-availability"] },
                  "source_url": { "type": "string", "format": "uri" }
                }
              }
            }
          },
          "official_url": { "type": "string", "format": "uri" },
          "status": { "enum": ["active", "beta", "legacy", "retirement-announced", "retired"] },
          "retirement_date": { "type": "string", "format": "date" },
          "retirement_scope": { "type": "string", "minLength": 1 },
          "retirement_source_url": { "type": "string", "format": "uri" },
          "replacement_exam_code": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]+$" },
          "replacement_official_url": { "type": "string", "format": "uri" },
          "source_id": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      }
    }
  },
  "additionalProperties": false
}
