{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certification source health snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_on", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "generated_on": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "checked_at", "status", "http_status", "final_url", "content_type", "page_title", "canonical_url", "duration_signals", "signal_fingerprint", "error"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "url": { "type": "string", "format": "uri" },
          "checked_at": { "type": "string", "format": "date-time" },
          "status": { "enum": ["ok", "blocked", "missing", "error"] },
          "http_status": { "type": ["integer", "null"] },
          "final_url": { "type": "string", "format": "uri" },
          "content_type": { "type": "string" },
          "page_title": { "type": "string" },
          "canonical_url": { "type": "string" },
          "duration_signals": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "signal_fingerprint": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    }
  }
}
