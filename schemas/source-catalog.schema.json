{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certification source catalog",
  "type": "object",
  "required": ["schema_version", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "publisher", "authority_class", "source_type", "access_model", "last_checked", "supported_exams"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "publisher": { "type": "string", "minLength": 1 },
          "authority_class": { "type": "integer", "minimum": 1, "maximum": 6 },
          "source_type": { "enum": ["exam-blueprint", "product-documentation", "official-training", "third-party-training", "expert-resource", "independent-assessment"] },
          "access_model": { "enum": ["public", "free-account", "paid"] },
          "last_checked": { "type": "string", "format": "date" },
          "supported_exams": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
