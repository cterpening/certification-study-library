    {
      "id": "github-catalog",
      "vendor_id": "github",
      "url": "https://learn.github.com/api/certifications",
      "cadence": "weekly",
      "extract": "github-json",
      "include": "/credentials/certifications/[^/]+/?$",
      "expected_text": "GitHub",
      "minimum_items": 6,
      "scope": "Six certification families from the public feed used by https://learn.github.com/certifications. Applied Skills are separate. This website interface is not a guaranteed integration API; contract failures require manual review.",
      "allowed_hosts": [
        "learn.microsoft.com"
      ]
    },
    {
      "id": "microsoft-catalog",
      "vendor_id": "microsoft",
      "url": "https://learn.microsoft.com/api/contentbrowser/search/credentials?locale=en-us&facet=roles&facet=products&facet=levels&facet=subjects&facet=credential_types&%24filter=(credential_types%2Fany(c%3A%20c%20eq%20%27certification%27))&%24orderBy=title&%24top=100&fuzzySearch=false",
      "cadence": "weekly",
      "extract": "microsoft-json",
      "include": "/credentials/certifications/[^/]+/?$",
      "expected_text": "Microsoft Certified",
      "minimum_items": 50,
      "scope": "Current English certification listings from the public feed used by Microsoft Learn Browse Credentials, including GitHub and MOS. Validate the total count and absence of a next page; never accept a truncated catalog. This is not the deprecated Learn Catalog API or authenticated Learn Platform API."
