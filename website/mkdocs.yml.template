site_name: Certification Study Library
site_description: Independent, source-driven certification study guides built from public objectives and documentation.
site_url: https://cterpening.github.io/certification-study-library/
docs_dir: docs
site_dir: ../site
strict: true

theme:
  name: material
  custom_dir: overrides
  language: en
  font: false
  favicon: assets/images/favicon.svg
  logo: assets/images/logo.svg
  icon:
    repo: fontawesome/brands/github
  palette:
    - media: "(prefers-color-scheme: light)"
      scheme: certification-light
      primary: custom
      accent: custom
      toggle:
        icon: material/weather-night
        name: Use dark mode
    - media: "(prefers-color-scheme: dark)"
      scheme: slate
      primary: custom
      accent: custom
      toggle:
        icon: material/weather-sunny
        name: Use light mode
  features:
    - navigation.tabs
    - navigation.tabs.sticky
    - navigation.sections
    - navigation.path
    - navigation.top
    - navigation.footer
    - toc.follow
    - search.suggest
    - search.highlight
    - search.share
    - content.code.copy

plugins:
  - search:
      lang: en

markdown_extensions:
  - abbr
  - admonition
  - attr_list
  - def_list
  - footnotes
  - md_in_html
  - tables
  - toc:
      permalink: true
      toc_depth: 2
  - pymdownx.details
  - pymdownx.highlight:
      anchor_linenums: true
  - pymdownx.inlinehilite
  - pymdownx.superfences
  - pymdownx.tabbed:
      alternate_style: true
  - pymdownx.tasklist:
      custom_checkbox: true

extra_css:
  - assets/stylesheets/extra.css

extra_javascript:
  - assets/javascripts/accessibility.js

extra:
  generator: false
  social:
    - icon: fontawesome/brands/github
      link: https://github.com/cterpening/certification-study-library
      name: Certification Study Library on GitHub

copyright: Original library content is licensed CC BY 4.0. Vendor trademarks and linked material belong to their respective owners.

{{SITE_NAV}}
